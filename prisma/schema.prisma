generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  CHEF
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String   @default("user")
  password  String // Will be hashed with bcrypt
  role      Role     @default(CHEF)
  createdAt DateTime @default(now())
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
model Package {
  id               String    @id @default(uuid())
  name             String    @unique
  pricePerPerson   Decimal   @db.Decimal(10, 2)
  description      String?
  includedItems    String    @db.Text
  isActive         Boolean   @default(true)
  sortOrder        Int       @default(0)
  bookings         Booking[]
  createdAt        DateTime  @default(now())
}

model Addon {
  id             String         @id @default(uuid())
  name           String         @unique
  pricePerPerson Decimal        @db.Decimal(10, 2)
  description    String?
  isActive       Boolean        @default(true)
  sortOrder      Int            @default(0)
  bookingAddons  BookingAddon[]
  createdAt      DateTime       @default(now())
}

model Booking {
  id              String         @id @default(uuid())
  bookingNumber   String         @unique
  packageId       String
  package         Package        @relation(fields: [packageId], references: [id])
  guestCount      Int
  eventDate       DateTime
  eventLocation   String
  customerName    String
  customerEmail   String?
  customerPhone   String
  packageTotal    Decimal        @db.Decimal(10, 2)
  addonsTotal     Decimal        @default(0) @db.Decimal(10, 2)
  drinksTotal Decimal        @default(0) @db.Decimal(10, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(10, 2) 
  grandTotal     Decimal        @db.Decimal(10, 2)
  downPayment    Decimal        @default(0) @db.Decimal(10, 2) 
  status          BookingStatus  @default(PENDING)
  notes           String?
  addons          BookingAddon[]
  drinks          BookingDrink[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model BookingAddon {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addonId   String
  addon     Addon   @relation(fields: [addonId], references: [id])
  quantity  Int     @default(1)
  subtotal  Decimal @db.Decimal(10, 2)
}

model Drink {
  id             String         @id @default(uuid())
  name           String         @unique
  pricePerPerson Decimal        @db.Decimal(10, 2)
  description    String?
  isActive       Boolean        @default(true)
  sortOrder      Int            @default(0)
  bookingDrinks  BookingDrink[]
  createdAt      DateTime       @default(now())
}

model BookingDrink {
  id        String  @id @default(uuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  drinkId   String
  drink     Drink   @relation(fields: [drinkId], references: [id])
  quantity  Int     @default(1)
  subtotal  Decimal @db.Decimal(10, 2)
}